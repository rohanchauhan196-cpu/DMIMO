# PostgreSQL connection string. For local dev with the included docker-compose.yml:
# docker compose up -d
# DATABASE_URL="postgresql://mimo:mimo@localhost:5432/mimo_architects?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/mimo_architects?schema=public"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Used only by prisma/seed.ts to create the first admin user
SEED_ADMIN_EMAIL="admin@dmimoarchitects.com"
SEED_ADMIN_PASSWORD="change-this-password"
